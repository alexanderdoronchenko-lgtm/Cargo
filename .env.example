# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Claude model to use — Diamond-tier reviews only (see GEMINI_*
# below for the other tiers)
CLAUDE_MODEL=claude-sonnet-5

# Google AI Studio key for Gemini — powers Free/Ruby/Emerald game reviews
# (Diamond stays on Claude, above). Get one at
# https://aistudio.google.com/apikey — sign in with a Google account, click
# "Create API key" (no billing/credit card needed to start on the free
# tier's rate limits; add a billing account there later if you outgrow
# them). Paste the key below, no quotes.
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional: Gemini model to use for Free/Ruby/Emerald reviews. Google
# retires Flash generations every few months (gemini-2.5-flash was already
# pulled from new API keys) — if this starts 404ing with "no longer
# available to new users", check https://ai.google.dev/gemini-api/docs/models
# for the current GA Flash model id.
GEMINI_MODEL=gemini-3.6-flash

# Optional: caps on Gemini usage across the whole bot process, protecting
# the API key's rate limit now that one review fires several parallel
# Gemini calls (batched explanations + a summary call). Raise
# GEMINI_MAX_REQUESTS_PER_MINUTE if the key is on a paid tier with a
# higher-than-free quota.
GEMINI_MAX_CONCURRENT_REQUESTS=12
GEMINI_MAX_REQUESTS_PER_MINUTE=14

# Optional: path to the SQLite database file
DB_PATH=bot.db

# Path to the Stockfish binary (required for engine analysis)
STOCKFISH_PATH=/usr/local/bin/stockfish

# Optional: subscription prices in Telegram Stars (XTR), per month
RUBY_PRICE_STARS=600
EMERALD_PRICE_STARS=750
DIAMOND_PRICE_STARS=3200

# Telegram Mini App URL — must be HTTPS (Telegram rejects http://).
# Placeholder until the Mini App is deployed; update after deploying and
# register the same URL in BotFather via /newapp (see DEPLOYMENT.md).
MINIAPP_URL=https://your-domain.example/

# Optional: your Telegram user_id — gets unlimited access to everything
# (game analyses, puzzles, opening trainer, streak freeze) for testing,
# regardless of actual subscription. Leave unset in production unless
# that's genuinely wanted.
ADMIN_USER_ID=
